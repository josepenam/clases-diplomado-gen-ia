# Copy this file to `.env` and fill in your real values. Never commit the real `.env`.
# Neo4j local (docker run -d --name neo4j-clase54 -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/password neo4j:5)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
# Opcional: solo para la sección de enriquecimiento con LLM
OPENAI_API_KEY=your-openai-api-key
